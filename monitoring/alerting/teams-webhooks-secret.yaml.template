# TEMPLATE ONLY — do not put real webhook URLs in this file and do not commit them.
#
# In Teams: Workflows app -> "Post to a channel when a webhook request is
# received" -> pick the channel -> copy the generated URL. (The old "Incoming
# Webhook" Office 365 connector is retired; msteamsv2Configs speaks the
# adaptive-card format that Workflows expects.)
#
# Create it on the bastion, one channel per severity:
#
#   kubectl create secret generic teams-webhooks -n monitoring \
#     --from-literal=warning_url='https://prod-XX.<region>.logic.azure.com:443/workflows/...' \
#     --from-literal=critical_url='https://prod-XX.<region>.logic.azure.com:443/workflows/...'
#
# Same channel for both? Use the same URL twice — you can split them later
# without touching the AlertmanagerConfig.
#
# The Secret MUST live in the `monitoring` namespace: prometheus-operator
# resolves webhookURL secret refs in the AlertmanagerConfig's own namespace.
#
# Rotation: delete and recreate. The operator regenerates the Alertmanager
# config within ~1 minute; no restart needed.

apiVersion: v1
kind: Secret
metadata:
  name: teams-webhooks
  namespace: monitoring
type: Opaque
stringData:
  warning_url: REPLACE_WITH_TEAMS_WORKFLOW_URL_FOR_WARNING_CHANNEL
  critical_url: REPLACE_WITH_TEAMS_WORKFLOW_URL_FOR_CRITICAL_CHANNEL
